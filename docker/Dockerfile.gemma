# GEMMA built from git HEAD with -loco support
#
# This image is used to generate LOCO reference fixtures for JAMMA validation.
# GEMMA -loco requires an annotation file (-a) with SNP_ID, bp_position, chromosome.
#
# Always build with --platform linux/amd64 (GEMMA is x86_64 only):
#   docker build --platform linux/amd64 -t gemma-loco -f docker/Dockerfile.gemma docker/
#
# Run:
#   docker run --rm --platform linux/amd64 -v $(pwd):/data gemma-loco \
#     -bfile /data/tests/fixtures/gemma_loco/test \
#     -a /data/tests/fixtures/gemma_loco/test_snps.txt \
#     -loco 1 -lmm 1 -o gemma_loco_chr1 -outdir /data/tests/fixtures/gemma_loco

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Build dependencies for GEMMA
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    libgsl-dev \
    libopenblas-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Clone and build GEMMA from git HEAD
RUN git clone --depth 1 https://github.com/genetics-statistics/GEMMA.git /opt/gemma && \
    cd /opt/gemma && \
    make -j4 && \
    cp bin/gemma /usr/local/bin/gemma

# Verify -loco is present in LMM help output (section 8)
RUN gemma -h 8 2>&1 | grep -q "loco" || (echo "ERROR: GEMMA -loco flag not found in LMM help output" && exit 1)

ENTRYPOINT ["/usr/local/bin/gemma"]
