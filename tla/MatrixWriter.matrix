spec MatrixWriter.tla
check INVARIANTS TypeOK Ownership DeliveryOrder ErrorOrder NoDeliveryAfterError PublishComplete JoinedAtReturn NoLeakAtReturn
check PROPERTIES Terminates ResultReturns CloseReturns
run w=1 s=1 n=0 fail=none | Items=0 Slots=1 Workers=1 FailAt={} InterruptJoin=TRUE
run w=1 s=1 n=1 fail=none | Items=1 Slots=1 Workers=1 FailAt={} InterruptJoin=TRUE
run w=1 s=1 n=1 fail=all | Items=1 Slots=1 Workers=1 FailAt={1} InterruptJoin=TRUE
