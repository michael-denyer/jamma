run w=2 s=2 n=5 fail=none | Items=5 Slots=2 Workers=2 FailAt={} InterruptJoin=TRUE
run w=2 s=2 n=5 fail=all | Items=5 Slots=2 Workers=2 FailAt={1,2,3,4,5} InterruptJoin=TRUE
run w=2 s=4 n=0 fail=none | Items=0 Slots=4 Workers=2 FailAt={} InterruptJoin=TRUE
