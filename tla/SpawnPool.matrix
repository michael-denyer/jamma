run workers=2 items=1 fail=all | Items=1 Workers=2 FailAt={1}
run workers=2 items=3 fail=all | Items=3 Workers=2 FailAt={1,2,3}
run workers=2 items=5 fail=all | Items=5 Workers=2 FailAt={1,2,3,4,5}
run workers=3 items=0 fail=all | Items=0 Workers=3 FailAt={}
